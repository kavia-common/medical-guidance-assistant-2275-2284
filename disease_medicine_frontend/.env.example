# Example environment file for Disease Medicine Frontend (React)
# Copy to ".env" and adjust as needed, then restart the dev server.

# Set the backend API base URL when the backend runs on a different origin/port.
# For example, if FastAPI runs on http://localhost:8000:
# REACT_APP_API_BASE_URL=http://localhost:8000
# Leave unset to use same-origin (useful if app is hosted with the backend or behind a proxy).
# REACT_APP_API_BASE_URL=

# To run the CRA dev server on a specific port without interactive prompts,
# you can set PORT here and use: npm run start:port
# e.g., PORT=3002 npm run start:port
# PORT=3002
