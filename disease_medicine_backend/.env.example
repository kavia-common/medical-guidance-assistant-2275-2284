# Example environment variables for Disease Medicine Backend
# Copy this file to .env and fill in the values as appropriate. Do NOT commit your real keys.

# Required: OpenAI API key for generating explanations
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override the default chat model (defaults to gpt-4o-mini)
OPENAI_MODEL_ID=gpt-4o-mini
